  "components": {
    "schemas": {
      "CustomTaxonomyCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Aliases"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CustomTaxonomyCreate"
      },
      "GitSettingsUpdate": {
        "properties": {
          "remote_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Remote Url"
          },
          "branch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "title": "Branch",
            "default": "main"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          },
          "user_email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ],
            "title": "User Email"
          }
        },
        "type": "object",
        "title": "GitSettingsUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeetCodeImportRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10,
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "LeetCodeImportRequest"
      },
      "MistakeCreate": {
        "properties": {
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "reason_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Reason Ids"
          },
          "observation": {
            "type": "string",
            "maxLength": 2000,
            "title": "Observation",
            "default": ""
          }
        },
        "type": "object",
        "title": "MistakeCreate"
      },
      "ProblemCreate": {
        "properties": {
          "record_initial_mistake": {
            "type": "boolean",
            "title": "Record Initial Mistake",
            "default": true
          },
          "title": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1,
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "source": {
            "type": "string",
            "maxLength": 32,
            "title": "Source",
            "default": "leetcode"
          },
          "source_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 180
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Key"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 180
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ],
            "title": "Difficulty",
            "default": "Medium"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Understood",
              "Resolved"
            ],
            "title": "Status",
            "default": "Open"
          },
          "primary_subtag_id": {
            "type": "string",
            "title": "Primary Subtag Id"
          },
          "taxonomy_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Taxonomy Ids"
          },
          "failure_reason_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Failure Reason Ids"
          },
          "python_code": {
            "type": "string",
            "maxLength": 200000,
            "title": "Python Code",
            "default": ""
          },
          "time_complexity": {
            "type": "string",
            "maxLength": 80,
            "title": "Time Complexity",
            "default": ""
          },
          "space_complexity": {
            "type": "string",
            "maxLength": 80,
            "title": "Space Complexity",
            "default": ""
          },
          "notes": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Notes"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "observation": {
            "type": "string",
            "maxLength": 2000,
            "title": "Observation",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title",
          "primary_subtag_id"
        ],
        "title": "ProblemCreate"
      },
      "ProblemUpdate": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Easy",
                  "Medium",
                  "Hard"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Difficulty"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Open",
                  "Understood",
                  "Resolved"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "primary_subtag_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Subtag Id"
          },
          "taxonomy_ids": {
